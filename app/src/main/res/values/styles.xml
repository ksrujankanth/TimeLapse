<resources>
    <style name="Widget.TimeLapse.Button.Main" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TimeLapse.Medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.TimeLapse.Button.Companion" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">8dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TimeLapse.Small</item>
    </style>

    <style name="ShapeAppearance.TimeLapse.Medium" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.TimeLapse.Small" parent="">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/nav_background</item>
        <item name="itemIconTint">@color/nav_item_color_state</item>
        <item name="itemTextColor">@color/nav_item_color_state</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.TimeLapse.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.TimeLapse.NavLabel</item>
    </style>
    
    <style name="TextAppearance.TimeLapse.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Theme.TimeLapse.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <style name="Widget.App.Tray" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@color/colorTrayBackground</item>
    </style>

    <!-- Split-Pill Button Style - Uses Material3 Dynamic Colors -->
    <style name="Widget.App.TrayButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Pill</item>
    </style>
    
    <!-- Helper text style for tray layouts -->
    <style name="Widget.App.HelperText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.TimeLapse.Helper</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    
    <style name="Widget.App.HelperTextSmall" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.TimeLapse.HelperSmall</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
</resources>
