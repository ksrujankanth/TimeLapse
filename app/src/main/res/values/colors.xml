<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light Theme Colors -->
    
    <!-- Background colors -->
    <color name="colorBackground">#FFFFFF</color>
    <color name="colorSurface">#F5F5F5</color>
    <color name="colorSurfaceVariant">#E8E8E8</color>
    <color name="colorTrayBackground">#F5F5F5</color>
    
    <!-- Primary accent colors -->
    <color name="colorPrimary">#4FC3F7</color>
    <color name="colorPrimaryVariant">#29B6F6</color>
    <color name="colorOnPrimary">#FFFFFF</color>
    <color name="colorSecondary">#4FC3F7</color>
