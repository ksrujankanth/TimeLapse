<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Top-anchored Close button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMaskClose"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="✕"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Top-anchored Done button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMaskDone"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="✓"
        android:textSize="20sp"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Info text about mask drawing -->
    <TextView
        android:id="@+id/tvMaskInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Draw over the subject you want to keep perfectly still."
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btnMaskClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/toolbarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="@color/toast_background"
        app:layout_constraintTop_toBottomOf="@id/tvMaskInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center_vertical">

            <!-- Zoom Mode -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeZoom"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Zoom"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="13sp" />

            <!-- Draw Mode -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeDraw"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Draw"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="13sp" />

            <!-- Erase Mode -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeErase"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Erase"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="13sp" />

            <!-- More Menu Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMore"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="More"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/arrow_up_float"
                app:iconGravity="end"
                app:iconSize="14dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="13sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
